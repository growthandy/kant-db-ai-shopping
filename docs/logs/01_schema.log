DROP FUNCTION
drop function if exists public.cancel_order(uuid);
DROP FUNCTION
drop table if exists public.order_items cascade;
DROP TABLE
drop table if exists public.orders cascade;
DROP TABLE
drop table if exists public.products cascade;
DROP TABLE
drop table if exists public.members cascade;
DROP TABLE
drop function if exists public.set_updated_at();
DROP FUNCTION
create function public.set_updated_at()
returns trigger
language plpgsql
as $$
begin
  new.updated_at := now();
  return new;
end;
$$;
CREATE FUNCTION
create table public.members (
  id             uuid        not null,
  name           text        not null,
  phone          text        not null,
  zip_code       text,
  address        text,
  address_detail text,
  member_type    text        not null default 'buyer',
  created_at     timestamptz not null default now(),
  updated_at     timestamptz not null default now(),
  deleted_at     timestamptz,
  constraint members_pk primary key (id),
  constraint members_id_fk foreign key (id) references auth.users (id) on delete cascade,
  constraint members_member_type_chk check (member_type in ('buyer', 'seller')),
  constraint members_phone_chk check (phone ~ '^01[0-9]-[0-9]{3,4}-[0-9]{4}$')
);
CREATE TABLE
create table public.products (
  id          uuid        not null default gen_random_uuid(),
  seller_id   uuid        not null,
  name        text        not null,
  description text,
  price       integer     not null,
  stock       integer     not null default 0,
  created_at  timestamptz not null default now(),
  updated_at  timestamptz not null default now(),
  deleted_at  timestamptz,
  constraint products_pk primary key (id),
  constraint products_seller_id_fk foreign key (seller_id) references public.members (id) on delete restrict,
  constraint products_price_chk check (price >= 0),
  constraint products_stock_chk check (stock >= 0)
);
CREATE TABLE
create table public.orders (
  id             uuid        not null default gen_random_uuid(),
  order_no       text        not null,
  user_id        uuid        not null,
  receiver_name  text        not null,
  receiver_phone text        not null,
  address        text        not null,
  delivery_memo  text,
  total_price    integer     not null default 0,
  order_status   text        not null default 'READY',
  created_at     timestamptz not null default now(),
  updated_at     timestamptz not null default now(),
  constraint orders_pk primary key (id),
  constraint orders_order_no_uq unique (order_no),
  constraint orders_user_id_fk foreign key (user_id) references public.members (id) on delete restrict,
  constraint orders_total_price_chk check (total_price >= 0),
  constraint orders_order_status_chk check (
    order_status in ('READY', 'ORDER', 'CONFIRM', 'PREPARE', 'ON_DELIVERY', 'DELIVERED')
  )
);
CREATE TABLE
create table public.order_items (
  id          uuid        not null default gen_random_uuid(),
  order_id    uuid        not null,
  product_id  uuid        not null,
  item_name   text        not null,
  item_price  integer     not null,
  quantity    integer     not null,
  created_at  timestamptz not null default now(),
  constraint order_items_pk primary key (id),
  constraint order_items_order_id_fk foreign key (order_id) references public.orders (id) on delete cascade,
  constraint order_items_product_id_fk foreign key (product_id) references public.products (id) on delete restrict,
  constraint order_items_quantity_chk check (quantity > 0),
  constraint order_items_item_price_chk check (item_price >= 0),
  constraint order_items_order_product_uq unique (order_id, product_id)
);
CREATE TABLE
create index idx_products_seller_id     on public.products (seller_id);
CREATE INDEX
create index idx_orders_user_id         on public.orders (user_id);
CREATE INDEX
create index idx_order_items_product_id on public.order_items (product_id);
CREATE INDEX
create trigger trg_members_updated_at  before update on public.members  for each row execute function public.set_updated_at();
CREATE TRIGGER
create trigger trg_products_updated_at before update on public.products for each row execute function public.set_updated_at();
CREATE TRIGGER
create trigger trg_orders_updated_at   before update on public.orders   for each row execute function public.set_updated_at();
