                               Table "public.members"
      Column      |           Type           | Collation | Nullable |    Default    
------------------+--------------------------+-----------+----------+---------------
 id               | uuid                     |           | not null | 
 name             | text                     |           | not null | 
 phone            | text                     |           | not null | 
 zip_code         | text                     |           |          | 
 address          | text                     |           |          | 
 address_detail   | text                     |           |          | 
 member_type      | text                     |           | not null | 'buyer'::text
 created_at       | timestamp with time zone |           | not null | now()
 updated_at       | timestamp with time zone |           | not null | now()
 deleted_at       | timestamp with time zone |           |          | 
 marketing_agreed | boolean                  |           | not null | false
Indexes:
    "members_pk" PRIMARY KEY, btree (id)
Check constraints:
    "members_member_type_chk" CHECK (member_type = ANY (ARRAY['buyer'::text, 'seller'::text]))
    "members_phone_chk" CHECK (phone ~ '^01[0-9]-[0-9]{3,4}-[0-9]{4}$'::text)
Foreign-key constraints:
    "members_id_fk" FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE
Referenced by:
    TABLE "orders" CONSTRAINT "orders_user_id_fk" FOREIGN KEY (user_id) REFERENCES members(id) ON DELETE RESTRICT
    TABLE "products" CONSTRAINT "products_seller_id_fk" FOREIGN KEY (seller_id) REFERENCES members(id) ON DELETE RESTRICT
Policies:
    POLICY "members_insert_own" FOR INSERT
      TO authenticated
      WITH CHECK (((id = ( SELECT auth.uid() AS uid)) AND (member_type = 'buyer'::text)))
    POLICY "members_select_own" FOR SELECT
      TO authenticated
      USING ((id = ( SELECT auth.uid() AS uid)))
    POLICY "members_update_own" FOR UPDATE
      TO authenticated
      USING ((id = ( SELECT auth.uid() AS uid)))
      WITH CHECK ((id = ( SELECT auth.uid() AS uid)))
Triggers:
    trg_members_updated_at BEFORE UPDATE ON members FOR EACH ROW EXECUTE FUNCTION set_updated_at()

                                      Table "public.products"
   Column    |           Type           | Collation | Nullable |              Default               
-------------+--------------------------+-----------+----------+------------------------------------
 id          | uuid                     |           | not null | gen_random_uuid()
 seller_id   | uuid                     |           | not null | 
 name        | text                     |           | not null | 
 description | text                     |           |          | '상품 설명을 입력해 주세요.'::text
 price       | integer                  |           | not null | 
 stock       | integer                  |           | not null | 0
 created_at  | timestamp with time zone |           | not null | now()
 updated_at  | timestamp with time zone |           | not null | now()
 deleted_at  | timestamp with time zone |           |          | 
Indexes:
    "products_pk" PRIMARY KEY, btree (id)
    "idx_products_seller_id" btree (seller_id)
    "products_seller_name_uq" UNIQUE CONSTRAINT, btree (seller_id, name)
Check constraints:
    "products_price_chk" CHECK (price >= 0)
    "products_stock_chk" CHECK (stock >= 0)
Foreign-key constraints:
    "products_seller_id_fk" FOREIGN KEY (seller_id) REFERENCES members(id) ON DELETE RESTRICT
Referenced by:
    TABLE "order_items" CONSTRAINT "order_items_product_id_fk" FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE RESTRICT
Policies:
    POLICY "products_delete_seller" FOR DELETE
      TO authenticated
      USING ((seller_id = ( SELECT auth.uid() AS uid)))
    POLICY "products_insert_seller" FOR INSERT
      TO authenticated
      WITH CHECK (((seller_id = ( SELECT auth.uid() AS uid)) AND (EXISTS ( SELECT 1
   FROM members m
  WHERE ((m.id = ( SELECT auth.uid() AS uid)) AND (m.member_type = 'seller'::text) AND (m.deleted_at IS NULL))))))
    POLICY "products_select_active" FOR SELECT
      TO authenticated
      USING (((deleted_at IS NULL) OR (seller_id = ( SELECT auth.uid() AS uid))))
    POLICY "products_update_seller" FOR UPDATE
      TO authenticated
      USING ((seller_id = ( SELECT auth.uid() AS uid)))
      WITH CHECK ((seller_id = ( SELECT auth.uid() AS uid)))
Triggers:
    trg_products_updated_at BEFORE UPDATE ON products FOR EACH ROW EXECUTE FUNCTION set_updated_at()

                                Table "public.orders"
     Column     |           Type           | Collation | Nullable |      Default      
----------------+--------------------------+-----------+----------+-------------------
 id             | uuid                     |           | not null | gen_random_uuid()
 order_no       | text                     |           | not null | 
 user_id        | uuid                     |           | not null | 
 receiver_name  | text                     |           | not null | 
 receiver_phone | text                     |           | not null | 
 address        | text                     |           | not null | 
 delivery_memo  | text                     |           |          | 
 total_price    | integer                  |           | not null | 0
 order_status   | text                     |           | not null | 'READY'::text
 created_at     | timestamp with time zone |           | not null | now()
 updated_at     | timestamp with time zone |           | not null | now()
Indexes:
    "orders_pk" PRIMARY KEY, btree (id)
    "idx_orders_user_id" btree (user_id)
    "orders_order_no_uq" UNIQUE CONSTRAINT, btree (order_no)
Check constraints:
    "orders_order_status_chk" CHECK (order_status = ANY (ARRAY['READY'::text, 'ORDER'::text, 'CONFIRM'::text, 'PREPARE'::text, 'ON_DELIVERY'::text, 'DELIVERED'::text]))
    "orders_total_price_chk" CHECK (total_price >= 0)
Foreign-key constraints:
    "orders_user_id_fk" FOREIGN KEY (user_id) REFERENCES members(id) ON DELETE RESTRICT
Referenced by:
    TABLE "order_items" CONSTRAINT "order_items_order_id_fk" FOREIGN KEY (order_id) REFERENCES orders(id) ON DELETE CASCADE
Policies:
    POLICY "orders_select_own" FOR SELECT
      TO authenticated
      USING ((user_id = ( SELECT auth.uid() AS uid)))
    POLICY "orders_update_own_before_payment" FOR UPDATE
      TO authenticated
      USING (((user_id = ( SELECT auth.uid() AS uid)) AND (order_status = ANY (ARRAY['READY'::text, 'ORDER'::text]))))
      WITH CHECK ((user_id = ( SELECT auth.uid() AS uid)))
Triggers:
    trg_orders_updated_at BEFORE UPDATE ON orders FOR EACH ROW EXECUTE FUNCTION set_updated_at()

                            Table "public.order_items"
   Column   |           Type           | Collation | Nullable |      Default      
------------+--------------------------+-----------+----------+-------------------
 id         | uuid                     |           | not null | gen_random_uuid()
 order_id   | uuid                     |           | not null | 
 product_id | uuid                     |           | not null | 
 item_name  | text                     |           | not null | 
 item_price | integer                  |           | not null | 
 quantity   | integer                  |           | not null | 
 created_at | timestamp with time zone |           | not null | now()
Indexes:
    "order_items_pk" PRIMARY KEY, btree (id)
    "idx_order_items_product_id" btree (product_id)
    "order_items_order_product_uq" UNIQUE CONSTRAINT, btree (order_id, product_id)
Check constraints:
    "order_items_item_price_chk" CHECK (item_price >= 0)
    "order_items_quantity_chk" CHECK (quantity > 0)
Foreign-key constraints:
    "order_items_order_id_fk" FOREIGN KEY (order_id) REFERENCES orders(id) ON DELETE CASCADE
    "order_items_product_id_fk" FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE RESTRICT
Policies:
    POLICY "order_items_select_own" FOR SELECT
      TO authenticated
      USING ((EXISTS ( SELECT 1
   FROM orders o
  WHERE ((o.id = order_items.order_id) AND (o.user_id = ( SELECT auth.uid() AS uid))))))

